# Single-connection configuration. For independent profiles, run db-semantic-mcp setup.
# db-semantic-mcp — Environment Configuration
# Copy this file to .env and fill in the required values.
# All variables use the SEMANTIC_MCP_ prefix.
# The .env file is loaded automatically from the process working directory.
#
# Required: SERVER, DATABASE, and either (USER + PASSWORD) or WINDOWS_AUTH=true

# --- Connection (required) ---
SEMANTIC_MCP_SERVER=localhost          # hostname, IP, named instance, or Azure FQDN
SEMANTIC_MCP_DATABASE=YourDatabase    # target database name
SEMANTIC_MCP_USER=sa                  # SQL auth user — omit if using Windows auth
SEMANTIC_MCP_PASSWORD=YourStrongPassword  # SQL auth password — omit if using Windows auth

# --- Connection (optional) ---
# SEMANTIC_MCP_PORT=1433              # override default TCP port
# SEMANTIC_MCP_WINDOWS_AUTH=false     # set true to use Windows auth (Windows only; omit USER/PASSWORD above)
# SEMANTIC_MCP_ENCRYPT=false          # force TLS — auto-enabled when server ends in .database.windows.net

# --- Cache and startup ---
# SEMANTIC_MCP_CACHE_PATH=./cache/semantic_mcp.db   # SQLite cache location; use absolute path for multi-instance setups
# SEMANTIC_MCP_CACHE_ENABLED=true                   # set false to skip startup warmup and automatic revalidation
# SEMANTIC_MCP_STARTUP_MODE=cache_first             # cache_first: reuse existing cache on restart | full: always refresh from SQL Server
# SEMANTIC_MCP_BACKGROUND_BATCH_SIZE=5              # tables analysed per background batch (tune for large schemas)
# SEMANTIC_MCP_BACKGROUND_INTERVAL_MS=500           # milliseconds between background batches
# SEMANTIC_MCP_SCHEMA_CACHE_TTL_S=300               # full snapshot maximum age; comments refresh even without structural drift
# SEMANTIC_MCP_PROBE_INTERVAL_S=60                  # minimum seconds between schema drift probes
# SEMANTIC_MCP_DB_WORKER_LIMIT=4                    # synchronous DB lifecycles allowed concurrently per MCP process
# SEMANTIC_MCP_BACKGROUND_RETRY_BASE_S=1            # failed classification retry base interval
# SEMANTIC_MCP_BACKGROUND_RETRY_MAX_S=60            # failed classification retry maximum interval

# --- Permissions: read-only by default; enable writes only when needed ---
# SEMANTIC_MCP_POLICY_FILE=./config/policy.example.json   # path to JSON policy file; builtin read-only used if unset
# SEMANTIC_MCP_POLICY_PROFILE=read_write_safe              # enable limited writes with the example policy file
# SEMANTIC_MCP_MAX_ROWS_RETURNED=1000                      # SELECT result row cap
# SEMANTIC_MCP_MAX_ROWS_AFFECTED=100                       # DML affected-row cap (rolled back if exceeded when STRICT_ROWS_AFFECTED_CAP=true; fixed connection profiles always roll back)
# SEMANTIC_MCP_QUERY_TIMEOUT=30                            # per-query timeout in seconds

# --- Tool surface ---
# SEMANTIC_MCP_TOOL_PROFILE=all
# Named profiles: query (2 tools), explore (8), maintenance (3); comma-separated groups remain supported.
# SEMANTIC_MCP_DISCOVERY_ALIASES='{"供應商":["Vendor","Supplier"]}'
# SEMANTIC_MCP_WORKFLOW_TOOLS_ENABLED=true
# SEMANTIC_MCP_DIRECT_EXECUTE_ENABLED=true
# SEMANTIC_MCP_STRICT_ROWS_AFFECTED_CAP=false              # default: report exceeded_cap and commit

# --- Output limits (row/cell data is capped; response envelope is additional) ---
# Old connection.json budget values are ignored; use explicit limits below.
# SEMANTIC_MCP_MAX_RESPONSE_BYTES=65536                    # column names + retained rows as JSON
# SEMANTIC_MCP_MAX_CELL_CHARS=2000
# SEMANTIC_MCP_MAX_LIST_ITEMS=500

# --- Metrics and analysis ---
# SEMANTIC_MCP_METRICS_ENABLED=true
# SEMANTIC_MCP_INTENT_ANALYZER=ast                         # routing only; authorization always uses strict TSQL AST

# --- Common scenarios (uncomment the relevant block) ---
#
# Windows Authentication (Windows only):
#   SEMANTIC_MCP_SERVER=MY-PC\\SQLEXPRESS
#   SEMANTIC_MCP_WINDOWS_AUTH=true
#   (remove USER and PASSWORD above)
#
# Azure SQL:
#   SEMANTIC_MCP_SERVER=yourserver.database.windows.net
#   SEMANTIC_MCP_USER=youradmin@yourserver
#   (ENCRYPT is enabled automatically for Azure SQL)
#
# LocalDB (Windows only):
#   SEMANTIC_MCP_SERVER=(localdb)\MSSQLLocalDB
#   SEMANTIC_MCP_WINDOWS_AUTH=true
#
# Custom policy (read-write with row caps):
#   SEMANTIC_MCP_POLICY_FILE=./config/policy.example.json
#   SEMANTIC_MCP_POLICY_PROFILE=read_write_safe
